# Copy this file to .env for local development. Never commit .env.
PORT=8787
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_FILE=./server/data/guestpass-data.json
# Comma-separated exact frontend origins. Use your deployed domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API origin. Set this in the frontend build environment for a separately hosted API.
VITE_API_BASE_URL=http://localhost:8787
