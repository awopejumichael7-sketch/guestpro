{
  "name": "guestpass-pro",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "test:api": "node --test server/test/*.test.js",
    "check:syntax": "node --check server/index.js && node --check server/routes/auth.js && node --check server/routes/events.js && node --check server/lib/security.js && node --check server/lib/store.js && node --check server/lib/middleware.js && node --check server/test/api.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "~5.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "zod": "^3.24.2",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "supertest": "^7.0.0"
  }
}
